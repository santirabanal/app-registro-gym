# Copiá este archivo como .env y completá los valores reales.
# NUNCA subas el .env real a git (ya está en el .gitignore).

# Connection string de tu base de datos Postgres (Supabase, Neon, etc.)
DATABASE_URL=postgres://usuario:password@host:5432/nombre_db

# Supabase Auth verifica la sesión y separa los registros por usuario.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Dejar vacía: el frontend usa Bearer tokens de Supabase.
API_KEY=

PORT=3002
